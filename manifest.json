{
	"manifest_version": 3,
	"name": "Proton Mail Select Next Email On Delete",
	"version": "1.0.0",
	"description": "Opens the next email automatically after you archive, delete or move the one you're reading in Proton Mail.",
	"browser_specific_settings": {
		"gecko": {
			"id": "proton-auto-advance@daan.local",
			"strict_min_version": "140.0",
			"data_collection_permissions": { "required": ["none"] }
		},
		"gecko_android": {
			"strict_min_version": "142.0"
		}
	},
	"permissions": ["storage"],
	"content_scripts": [
		{
			"matches": ["https://mail.proton.me/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"options_ui": {
		"page": "options.html"
	}
}
